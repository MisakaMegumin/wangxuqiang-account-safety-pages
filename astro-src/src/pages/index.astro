---
import fs from 'node:fs';
import { load as yamlLoad } from 'js-yaml';

// 单一事实源：content/resume.md（编辑该文件的 YAML frontmatter，再重新构建）
// 路径相对本文件解析，整目录可直接迁移到任意机器 / GitHub 仓库
const raw = fs.readFileSync(new URL('../../content/resume.md', import.meta.url), 'utf8');
const fm = raw.match(/^---\r?\n([\s\S]*?)\r?\n---/);
const C = yamlLoad(fm[1]);

const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const ICONS = {
  "数据分析": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>',
  "AI 应用": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/></svg>',
  "风控中台": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6z"/></svg>',
  "风控产品体系": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 2 7l10 5 10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>',
  "技术理解": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 6-6 6 6 6M16 6l6 6-6 6"/></svg>',
  "协作合作": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 4.5a3.5 3.5 0 0 1 0 7M21.5 20c0-3-1.9-5-4.5-5.6"/></svg>',
  "项目管理": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 4v16M3 9h18"/></svg>',
  "合规业务域": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M5 7l7-4 7 4M3 13l4-6 4 6a4 4 0 0 1-8 0zM13 13l4-6 4 6a4 4 0 0 1-8 0z"/></svg>',
};

const hero = {
  name: C.name, tagline: C.tagline, contact: C.contact, contact2: C.contact2,
  stats: C.stats, intro1: C.intro1, intro2: C.intro2,
};
const jobs = C.jobs;
const aiFlow = C.aiFlow;
const projects = C.projects.map((p, i) => ({ letter: LETTERS[i], title: p.title, period: p.period, points: p.points }));
const skills = C.skills.map(s => ({ name: s.name, desc: s.desc, icon: ICONS[s.name] || ICONS["技术理解"] }));
const honors = C.honors;
const footer = C.footer;
---

<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>王续强</title>
  <meta name="description" content="王续强 — 11 年账号安全与业务风控产品经验，覆盖恶意账号治理、客诉响应、策略质量运营与风控数据建设。" />
  <style>
    :root{
      --text:#333333; --gray:#6f6f6f; --faint:#a3a3a3;
      --border:#e3e1d6; --bar:#eceae2; --chip:#fcfbf7; --bg:#f5f5f0;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--text);font-size:15px;line-height:1.75;letter-spacing:.015em;
      font-family:"PingFang SC",ui,-apple-system,BlinkMacSystemFont,"Hiragino Sans GB","Microsoft YaHei","Segoe UI",Helvetica,Arial,sans-serif;
      -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
    .wrap{max-width:1080px;margin:0 auto;padding:56px 40px 90px}
    h1,h2,h3,h4{line-height:1.3;font-weight:700;color:var(--text)}
    p{margin:0 0 13px}
    ul{margin:8px 0;padding-left:24px}
    li{margin:7px 0}
    svg{display:inline-block;vertical-align:middle}

    /* page head */
    .page-icon{width:44px;height:44px;color:#333333}
    .page-icon svg{width:100%;height:100%}
    .page-head{display:flex;align-items:center;gap:16px;margin:14px 0 4px}
    h1{font-size:40px;margin:0;letter-spacing:.01em}
    .role{font-size:19px;font-weight:600;color:var(--text)}
    .tagline{color:var(--gray);font-size:14.5px;margin-top:2px}

    /* gray bar toggle (Read me first / projects) */
    details.bar{margin:18px 0}
    details.bar > summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:10px;
      background:var(--bar);border-radius:8px;padding:11px 15px;font-size:15px;font-weight:600;color:var(--text);user-select:none}
    details.bar > summary::-webkit-details-marker{display:none}
    details.bar > summary:hover{background:#e4e2d9}
    .tri{flex:none;color:var(--gray);font-size:11px;transition:transform .15s ease;display:inline-block;width:12px}
    details[open].bar > summary .tri{transform:rotate(90deg)}
    .bar-body{padding:16px 6px 4px 24px}
    .readme-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
    .readme-stats div{background:var(--chip);border:1px solid var(--border);border-radius:7px;padding:9px 12px}
    .readme-stats b{display:block;font-size:15px}
    .readme-stats i{font-style:normal;font-size:12px;color:var(--gray)}
    .contact-line{font-size:14px;color:var(--text)}
    .contact-line + .contact-line{color:var(--gray);margin-top:2px}

    /* introduction */
    .intro-row{display:flex;gap:28px;align-items:flex-start;margin:32px 0 14px}
    .intro-text{flex:1}
    .intro-text p{color:var(--text);font-size:15.5px;line-height:1.8;margin-bottom:15px}

    /* section gray bar */
    .secbar{display:flex;align-items:center;gap:10px;background:transparent;border-radius:0;
      padding:0 2px 10px;margin:48px 0 20px;font-weight:700;font-size:21px;letter-spacing:.02em;
      border-bottom:1.5px solid #333333}
    .secbar .sic{flex:none;width:20px;height:20px;color:#333333;display:inline-flex}
    .secbar .sic svg{width:100%;height:100%}
    .hint{color:var(--faint);font-size:13px;margin:-6px 0 12px}

    /* job */
    .job{margin:22px 0 34px}
    .job-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;padding-bottom:8px;border-bottom:1px solid var(--border)}
    .job-head h3{font-size:18.5px;margin:0}
    .job-head .co{color:var(--text)}
    .period{margin-left:auto;font-size:12.5px;color:var(--gray);background:var(--chip);border:1px solid var(--border);padding:3px 11px;border-radius:6px;white-space:nowrap}
    .job ul{margin-top:12px}
    .job li{color:var(--text);font-size:15px;line-height:1.8}

    /* project toggle */
    details.proj{margin:10px 0}
    details.proj > summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:10px;
      background:var(--bar);border-radius:8px;padding:12px 15px;user-select:none}
    details.proj > summary::-webkit-details-marker{display:none}
    details.proj > summary:hover{background:#e4e2d9}
    .letter{flex:none;width:25px;height:25px;border-radius:6px;background:#333333;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12.5px}
    .st{flex:1;font-weight:600;font-size:15px}
    .sp{font-size:12px;color:var(--gray);white-space:nowrap}
    .proj-body{padding:14px 8px 18px 26px}
    .pt{display:flex;gap:14px;margin:12px 0}
    .pt .lab{flex:none;width:9.4em;font-size:13px;font-weight:700;color:var(--text);padding-top:2px;letter-spacing:.02em}
    .pt .tx{font-size:14.5px;color:var(--text);line-height:1.8;flex:1;min-width:0}

    /* skills chips */
    .skill-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
    .skill{border:1px solid var(--border);border-radius:9px;padding:15px 16px;background:#fcfcf9}
    .skill h4{margin:0 0 8px;font-size:14.5px;display:flex;align-items:center;gap:8px;color:var(--text)}
    .skill h4 .sic{width:17px;height:17px;color:#333333;display:inline-flex;flex:none}
    .skill h4 .sic svg{width:100%;height:100%}
    .skill p{margin:0;font-size:13px;color:var(--gray);line-height:1.7}

    /* honors */
    .honors-list{font-size:14px;color:var(--text);line-height:1.75}
    .honors-list li{margin:8px 0}

    footer{margin-top:46px;padding-top:16px;border-top:1px solid var(--border);color:var(--faint);font-size:12.5px;text-align:center}

    @media (max-width:900px){
      .wrap{padding:44px 24px 80px}
      .skill-grid{grid-template-columns:repeat(2,1fr)}
      .readme-stats{grid-template-columns:repeat(2,1fr)}
    }
    @media (max-width:640px){
      body{font-size:16px}
      .wrap{padding:36px 18px 70px}
      h1{font-size:32px}
      .intro-row{flex-direction:column}
      .intro-text p{font-size:16.5px}
      .intro-row{margin-top:26px}
      .skill-grid{grid-template-columns:1fr}
      .readme-stats{grid-template-columns:1fr}
      .job li{font-size:16px}
      .pt{flex-direction:column;gap:3px}
      .pt .lab{width:auto}
      .pt .tx{font-size:16px;max-width:none}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <!-- 页头（黑白图标 + 大标题） -->
    <div class="page-head">
      <div class="page-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="8.6" cy="10.4" r="1.9"/><path d="M5.6 15.6c.6-1.7 1.7-2.5 3-2.5s2.4.8 3 2.5M13.6 8.6h5M13.6 12h5M13.6 15.4h3.2"/></svg>
      </div>
      <h1>{hero.name}</h1>
    </div>
    <div class="tagline">{hero.tagline}</div>

    <!-- Read me first 折叠条 -->
    <details class="bar" open>
      <summary><span class="tri">▸</span><span>快速了解 · Read me first</span></summary>
      <div class="bar-body">
        <div class="contact-line">{hero.contact}</div>
        <div class="contact-line">{hero.contact2}</div>
        <div class="readme-stats">
          {hero.stats.map(s => <div><b>{s.num}</b><i>{s.label}</i></div>)}
        </div>
      </div>
    </details>

    <!-- 个人简介 -->
    <div class="intro-row">
      <div class="intro-text">
        <p>{hero.intro1}</p>
        <p>{hero.intro2}</p>
      </div>
    </div>

    <!-- 工作经历 -->
    <div class="secbar"><span class="sic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="11" rx="2"/><path d="M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/></svg></span>工作经历</div>
    {jobs.map((j) => (
      <div class="job">
        <div class="job-head">
          <h3><span class="co">{j.co}</span> — {j.role}</h3>
          <span class="period">{j.period}</span>
        </div>
        <ul>{j.points.map(p => <li>{p}</li>)}</ul>
      </div>
    ))}

    <!-- AI 工作流实践 -->
    <div class="secbar"><span class="sic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/></svg></span>AI 工作流实践</div>
    <ul>{aiFlow.map(p => <li>{p}</li>)}</ul>

    <!-- 重点项目（折叠条） -->
    <div class="secbar"><span class="sic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>重点项目</div>
    <p class="hint">优先展示账号安全经历；点击标题栏可展开或收起项目内容</p>
    {projects.map(p => (
      <details class="proj" open>
        <summary>
          <span class="tri">▸</span>
          <span class="letter">{p.letter}</span>
          <span class="st">{p.title}</span>
          <span class="sp">{p.period}</span>
        </summary>
        <div class="proj-body">
          {p.points.map(pt => (
            <div class="pt">
              <span class="lab">{pt.label}</span>
              <span class="tx">{pt.text}</span>
            </div>
          ))}
        </div>
      </details>
    ))}

    <!-- 技能 -->
    <div class="secbar"><span class="sic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/></svg></span>技能</div>
    <div class="skill-grid">
      {skills.map(s => (
        <div class="skill">
          <h4><span class="sic" set:html={s.icon}></span>{s.name}</h4>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>

    <!-- 荣誉 -->
    <div class="secbar"><span class="sic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="9" r="5"/><path d="M8.6 13.6 7 21l5-2.6L17 21l-1.6-7.4"/></svg></span>奖项 & 荣誉</div>
    <ul class="honors-list">{honors.map(h => <li>{h}</li>)}</ul>

    <footer>{footer}</footer>
  </div>

</body>
</html>
